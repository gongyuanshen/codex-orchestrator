{
  "mcpServers": {
    "tri_orchestrator": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--project",
        ".",
        "python",
        "-m",
        "orchestrator.mcp_shim"
      ],
      "cwd": ".",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "env_vars": [
        "CODEX_HOME",
        "LOCALAPPDATA",
        "USERPROFILE",
        "HOME",
        "PATH",
        "TRI_ORCH_HOST",
        "TRI_ORCH_PORT",
        "TRI_ORCH_DATA_DIR",
        "TRI_ORCH_STALL_SEC",
        "TRI_ORCH_WATCHDOG_INTERVAL_SEC",
        "TRI_ORCH_PORT_RANGE",
        "TRI_ORCH_MAX_SNAPSHOT_MB",
        "TRI_ORCH_GC_INTERVAL_SEC",
        "TRI_ORCH_RESULT_TTL_SEC",
        "TRI_ORCH_RESULT_MAX_FILES",
        "TRI_ORCH_WORKSPACE_RETENTION_SEC",
        "TRI_ORCH_GIT_BACKEND",
        "TRI_ORCH_TOOL_TIER",
        "TRI_ORCH_HOST_WAKE"
      ],
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 300
    }
  }
}
